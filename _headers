/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-XSS-Protection: 1; mode=block
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://schema.org; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://*.robsoncassiano.software https://treinamento.robsoncassiano.software; connect-src 'self' https://api.bcb.gov.br https://brasilapi.com.br https://eu.robsoncassiano.software;

# Cache static assets
/img/*
  Cache-Control: public, max-age=31536000, immutable

/index.css
  Cache-Control: public, max-age=0, must-revalidate

/index.js
  Cache-Control: public, max-age=0, must-revalidate
